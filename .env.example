# Server-only. Never prefix either variable with PUBLIC_ or VITE_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
GEMINI_API_KEY=your-gemini-api-key
# DeepSeek is used only for grounded answer generation.
DEEPSEEK_API_KEY=your-deepseek-api-key
# Optional. Defaults to the low-cost non-reasoning model below.
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional semantic-retrieval settings.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
ASK_GABRIEL_MATCH_THRESHOLD=0.62
ASK_GABRIEL_MATCH_COUNT=5
