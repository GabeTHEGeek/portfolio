---
import { getCollection } from 'astro:content';
import { sortContent } from '../../utils/content-order';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SystemEntry from '../../components/SystemEntry.astro';
const projects = sortContent(await getCollection('projects'), 'projects');
---
<BaseLayout title="Projects" description="Selected product work and case studies by Gabriel Pendleton.">
  <header class="page-hero wrap"><p class="eyebrow cyan">Systems Built</p><h1>Products built at the edge of <span>AI, platforms, and people.</span></h1><p class="lede">Case studies and selected project work across AI-native products, creator platforms, marketplaces, and technical infrastructure.</p></header>
  <section class="wrap section-block"><div class="system-registry project-registry">{projects.map((project, index) => <SystemEntry {project} {index} open />)}</div></section>
</BaseLayout>
