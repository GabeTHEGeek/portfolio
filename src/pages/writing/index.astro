---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { Image } from 'astro:assets';
const articles = (await getCollection('writing')).sort((a, b) => a.data.order - b.data.order || b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const [featured, ...recent] = articles;
const categories = [...new Set(articles.map((article) => article.data.category))];
---
<BaseLayout title="Writing" description="Writing by Gabriel Pendleton on AI-native products and product leadership.">
  <header class="page-hero wrap"><p class="eyebrow cyan">Notes from building</p><h1>Writing about <span>AI, product, and the systems behind the work.</span></h1><p class="lede">I write about what I’m building, what I’m learning, and how AI is changing product strategy, software, and the way teams operate.</p><ul class="topic-bar">{categories.map((category) => <li>{category}</li>)}</ul></header>
  {featured && <section class="wrap writing-feature"><div class="section-head"><div><p class="eyebrow">Featured</p><h2>Start here.</h2></div><p>A deeper look at the products, ideas, and systems I’m actively working through.</p></div><article><a class="feature-visual article-feature-visual" href={`/writing/${featured.data.slug}/`}>{featured.data.coverImage && <Image src={featured.data.coverImage} alt="" width={1200} widths={[700, 1000, 1200]} sizes="(max-width: 940px) 92vw, 55vw" loading="eager" fetchpriority="high" />}</a><div class="feature-copy"><p class="eyebrow cyan">{featured.data.category} · {featured.data.readTime}</p><h3>{featured.data.title}</h3><p>{featured.data.description}</p><a class="text-link" href={`/writing/${featured.data.slug}/`}>Read article →</a></div></article></section>}
  <section class="band"><div class="wrap"><div class="section-head"><div><p class="eyebrow">Recent</p><h2>What I’m thinking about.</h2></div><p>Pieces on product design, AI workflows, local software, and lessons from shipping.</p></div><div class="article-grid">{recent.map((article) => <ArticleCard {article} />)}</div></div></section>
</BaseLayout>
