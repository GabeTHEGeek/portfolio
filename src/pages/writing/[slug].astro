---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import authorPortrait from '../../assets/gabriel-pendleton-cyborg-v2.png';
import { readingTime } from '../../utils/reading-time';
import { getYouTubeEmbedUrl } from '../../utils/youtube';

export async function getStaticPaths() {
  const articles = await getCollection('writing', ({ data }) => !data.draft);
  return articles.map((article) => ({ params: { slug: article.data.slug }, props: { article } }));
}
type Props = { article: CollectionEntry<'writing'> };
const { article } = Astro.props;
const { Content, headings } = await render(article);
const duration = readingTime(article.body ?? '');
const videoEmbedUrl = getYouTubeEmbedUrl(article.data.videoUrl);
const aeoSummary = article.data.aeoSummary ?? article.data.description;
const faq = article.data.faq ?? [];
const allArticles = await getCollection('writing', ({ data }) => !data.draft);
const related = allArticles.filter(({ id }) => id !== article.id).map((entry) => ({ entry, shared: entry.data.tags.filter((tag) => article.data.tags.includes(tag)).length })).sort((a, b) => b.shared - a.shared || b.entry.data.publishDate.valueOf() - a.entry.data.publishDate.valueOf()).slice(0, 3).map(({ entry }) => entry);
const articleSchema = {
  '@type': 'Article', headline: article.data.title,
  description: article.data.description, datePublished: article.data.publishDate.toISOString(),
  mainEntityOfPage: new URL(`/writing/${article.data.slug}/`, Astro.site).href,
  author: { '@type': 'Person', name: article.data.author, url: Astro.site }
};
const schema = faq.length ? {
  '@context': 'https://schema.org',
  '@graph': [
    articleSchema,
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer }
      }))
    }
  ]
} : { '@context': 'https://schema.org', ...articleSchema };
---
<BaseLayout title={article.data.title} description={article.data.description} image={article.data.coverImage} type="article" publishedTime={article.data.publishDate} {schema} bodyClass="article-page">
  <header class="article-hero wrap">
    <p class="crumbs"><a href="/writing/">Writing</a><span>/</span><span>{article.data.category}</span></p>
    <p class="eyebrow cyan">{article.data.category}</p><h1>{article.data.title}</h1><p class="lede">{article.data.description}</p>
    <div class="article-meta"><Image class="avatar" src={authorPortrait} alt="" width={40} height={40} widths={[40, 80]} sizes="40px" format="webp" /><div><strong>{article.data.author}</strong><span><time datetime={article.data.publishDate.toISOString()}>{article.data.publishDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' })}</time> · {duration} · <span class="article-view-count" data-article-views data-slug={article.data.slug}>Views loading</span></span></div></div>
    {videoEmbedUrl ? (
      <div class="article-hero-video">
        <iframe
          src={videoEmbedUrl}
          title={`${article.data.title} video`}
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>
    ) : article.data.coverImage && <Image class="article-hero-image" src={article.data.coverImage} alt="" width={1600} widths={[800, 1200, 1600]} sizes="92vw" />}
  </header>
  <div class="article-shell wrap">
    <aside class="toc"><p class="eyebrow">In this article</p><nav aria-label="Table of contents">{headings.filter(({ depth }) => depth === 2 || depth === 3).map((heading, index) => <a class:list={[`depth-${heading.depth}`]} href={`#${heading.slug}`}><span class="toc-number">{String(index + 1).padStart(2, '0')}</span><span>{heading.text}</span></a>)}{faq.length > 0 && <a class="depth-2" href="#frequently-asked-questions"><span class="toc-number">{String(headings.filter(({ depth }) => depth === 2 || depth === 3).length + 1).padStart(2, '0')}</span><span>Frequently asked questions</span></a>}</nav></aside>
    <article class="article-prose">
      <section class="article-aeo-summary" aria-labelledby="aeo-summary-title">
        <p class="eyebrow">AEO summary</p>
        <h2 id="aeo-summary-title">The short answer</h2>
        <p>{aeoSummary}</p>
      </section>
      <Content />
      {faq.length > 0 && <section class="article-faq" id="frequently-asked-questions" aria-labelledby="faq-title">
        <p class="eyebrow">FAQ</p>
        <h2 id="faq-title">Frequently asked questions</h2>
        <div class="article-faq-list">{faq.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div>
      </section>}
      <footer class="article-end"><h2>Keep exploring</h2><p>More product thinking and hands-on AI work from Gabriel Pendleton.</p><div class="article-actions"><a class="command-button primary" href="/writing/"><span class="command-button__content"><b>AR</b> ALL WRITING</span></a><a class="command-button" href="/projects/"><span class="command-button__content"><b>SYS</b> VIEW PROJECTS</span></a></div></footer>
    </article>
  </div>
  {related.length > 0 && <section class="related band"><div class="wrap"><div class="section-head"><div><p class="eyebrow">Related</p><h2>Continue reading.</h2></div></div><div class="related-grid">{related.map((item) => <a href={`/writing/${item.data.slug}/`}><span>{item.data.category} · {readingTime(item.body ?? '')}</span><h3>{item.data.title}</h3><p>{item.data.description}</p></a>)}</div></div></section>}
</BaseLayout>

<script>
  const sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc nav a'));
  sectionLinks.forEach((link) => {
    document.getElementById(decodeURIComponent(link.hash.slice(1)))?.setAttribute('tabindex', '-1');
  });
  const syncSection = () => {
    sectionLinks.forEach((link) => {
      if (link.hash === window.location.hash) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  };
  window.addEventListener('hashchange', syncSection);
  syncSection();

  const viewCounter = document.querySelector<HTMLElement>('[data-article-views]');
  const articleSlug = viewCounter?.dataset.slug;
  if (viewCounter && articleSlug) {
    const storageKey = `article-view:${articleSlug}`;
    const counted = sessionStorage.getItem(storageKey) === '1';
    fetch(`/.netlify/functions/article-views${counted ? `?slug=${encodeURIComponent(articleSlug)}` : ''}`, {
      method: counted ? 'GET' : 'POST',
      headers: counted ? undefined : { 'content-type': 'application/json' },
      body: counted ? undefined : JSON.stringify({ slug: articleSlug })
    })
      .then((response) => response.ok ? response.json() : Promise.reject(new Error('View count unavailable')))
      .then(({ views }) => {
        const count = Number(views);
        if (!Number.isFinite(count) || count < 0) throw new Error('Invalid view count');
        if (!counted) sessionStorage.setItem(storageKey, '1');
        viewCounter.textContent = `${count.toLocaleString()} ${count === 1 ? 'view' : 'views'}`;
      })
      .catch(() => { viewCounter.textContent = 'Views unavailable'; });
  }
</script>

<style is:global>
  .article-meta .avatar { width: 40px; height: 40px; flex-shrink: 0; object-fit: cover; border-radius: 50%; }
  .article-view-count { color: var(--cyan); }
  .article-prose { counter-reset: article-section; }
  .article-aeo-summary {
    margin: 0 0 38px;
    padding: 22px 24px;
    border: 1px solid var(--line);
    border-left: 3px solid var(--signal);
    background: color-mix(in srgb, var(--signal) 7%, var(--panel));
  }
  .article-aeo-summary .eyebrow { margin-bottom: 8px; color: var(--signal); }
  .article-aeo-summary h2 { margin: 0 0 10px; padding: 0; border: 0; background: none; font-size: clamp(1.35rem, 3vw, 2rem); }
  .article-aeo-summary h2::before { display: none; }
  .article-aeo-summary > p:last-child { margin: 0; font-size: 1.05em; }
  .article-prose > :is(h2, h3)[id] {
    counter-increment: article-section;
    scroll-margin-top: 150px;
    padding: 18px 20px;
    border-top: 1px solid var(--line);
    border-left: 3px solid var(--cyan);
    background: var(--panel);
  }
  .article-prose > :is(h2, h3)[id]::before {
    content: 'SECTION ' counter(article-section, decimal-leading-zero);
    display: block;
    margin-bottom: 10px;
    color: var(--cyan);
    font: 12px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .12em;
  }
  .article-prose > :is(h2, h3)[id]:target {
    border-left-color: var(--signal);
    background: color-mix(in srgb, var(--signal) 12%, var(--panel));
    outline: 1px solid var(--signal);
    outline-offset: 0;
  }
  .article-prose > :is(h2, h3)[id]:target::before { color: var(--signal); }
  .article-shell .toc nav a {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    column-gap: 14px;
    align-items: baseline;
    padding-left: 12px;
    text-align: left;
  }
  .article-shell .toc nav a > span:last-child { text-align: left; }
  .toc-number { flex-shrink: 0; color: var(--cyan); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  .toc nav a[aria-current='location'] { color: var(--signal); border-left-color: var(--signal); background: color-mix(in srgb, var(--signal) 8%, var(--panel)); }
  .toc nav a[aria-current='location'] .toc-number { color: var(--signal); }
  .article-faq { scroll-margin-top: 150px; margin-top: 56px; }
  .article-faq > h2 { margin-top: 0; }
  .article-faq-list { display: grid; gap: 10px; }
  .article-faq details { border: 1px solid var(--line); background: var(--panel); }
  .article-faq summary { padding: 16px 18px; color: var(--text); font-weight: 700; cursor: pointer; }
  .article-faq details p { margin: 0; padding: 0 18px 18px; color: var(--muted); }
  .article-hero-video {
    width: 100%;
    aspect-ratio: 16 / 9;
    margin-top: 42px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--deep);
    clip-path: polygon(18px 0, 100% 0, 100% calc(100% - 18px), calc(100% - 18px) 100%, 0 100%, 0 18px);
  }
  .article-hero-video iframe { display: block; width: 100%; height: 100%; border: 0; }
</style>
