---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('writing');
  return articles.map((article) => ({ params: { slug: article.data.slug }, props: { article } }));
}
type Props = { article: CollectionEntry<'writing'> };
const { article } = Astro.props;
const { Content, headings } = await render(article);
const allArticles = await getCollection('writing');
const related = allArticles.filter(({ id }) => id !== article.id).map((entry) => ({ entry, shared: entry.data.tags.filter((tag) => article.data.tags.includes(tag)).length })).sort((a, b) => b.shared - a.shared || b.entry.data.publishDate.valueOf() - a.entry.data.publishDate.valueOf()).slice(0, 3).map(({ entry }) => entry);
const schema = {
  '@context': 'https://schema.org', '@type': 'Article', headline: article.data.title,
  description: article.data.description, datePublished: article.data.publishDate.toISOString(),
  mainEntityOfPage: new URL(`/writing/${article.data.slug}/`, Astro.site).href,
  author: { '@type': 'Person', name: article.data.author, url: Astro.site }
};
---
<BaseLayout title={article.data.title} description={article.data.description} image={article.data.coverImage} type="article" publishedTime={article.data.publishDate} {schema} bodyClass="article-page">
  <header class="article-hero wrap">
    <p class="crumbs"><a href="/writing/">Writing</a><span>/</span><span>{article.data.category}</span></p>
    <p class="eyebrow cyan">{article.data.category}</p><h1>{article.data.title}</h1><p class="lede">{article.data.description}</p>
    <div class="article-meta"><span class="avatar" aria-hidden="true">GP</span><div><strong>{article.data.author}</strong><span><time datetime={article.data.publishDate.toISOString()}>{article.data.publishDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' })}</time> · {article.data.readTime}</span></div></div>
    {article.data.coverImage && <Image class="article-hero-image" src={article.data.coverImage} alt="" width={1600} widths={[800, 1200, 1600]} sizes="92vw" />}
  </header>
  <div class="article-shell wrap">
    <aside class="toc"><p class="eyebrow">In this article</p><nav aria-label="Table of contents">{headings.filter(({ depth }) => depth === 2 || depth === 3).map((heading) => <a class:list={[`depth-${heading.depth}`]} href={`#${heading.slug}`}>{heading.text}</a>)}</nav></aside>
    <article class="article-prose"><Content /><footer class="article-end"><h2>Keep exploring</h2><p>More product thinking and hands-on AI work from Gabriel Pendleton.</p><div class="article-actions"><a class="command-button primary" href="/writing/"><span class="command-button__content"><b>AR</b> ALL WRITING</span></a><a class="command-button" href="/projects/"><span class="command-button__content"><b>SYS</b> VIEW PROJECTS</span></a></div></footer></article>
  </div>
  {related.length > 0 && <section class="related band"><div class="wrap"><div class="section-head"><div><p class="eyebrow">Related</p><h2>Continue reading.</h2></div></div><div class="related-grid">{related.map((item) => <a href={`/writing/${item.data.slug}/`}><span>{item.data.category} · {item.data.readTime}</span><h3>{item.data.title}</h3><p>{item.data.description}</p></a>)}</div></div></section>}
</BaseLayout>
