---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InteractionLayer from '../components/InteractionLayer.astro';
import SoundtrackPlayer from '../components/SoundtrackPlayer.astro';
import defaultSocialImage from '../assets/social-preview.png';
import '../styles/global.css';
import '../styles/interface.css';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  type?: 'website' | 'article';
  publishedTime?: Date;
  schema?: Record<string, unknown>;
  bodyClass?: string;
  noindex?: boolean;
}

const { title, description, image, type = 'website', publishedTime, schema, bodyClass, noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const resolvedImage = image ?? defaultSocialImage;
const socialImage = new URL(resolvedImage.src, Astro.site);
const fullTitle = title === 'Gabriel Pendleton' ? title : `${title} | Gabriel Pendleton`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#050a11" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <script is:inline>
      (() => {
        try { document.documentElement.dataset.theme = localStorage.getItem('command-theme') || 'dark'; }
        catch { document.documentElement.dataset.theme = 'dark'; }
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Gabriel Pendleton" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content={String(resolvedImage.width)} />
    <meta property="og:image:height" content={String(resolvedImage.height)} />
    <meta property="og:image:alt" content="Gabriel Pendleton — Senior Product Leader" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Gabriel Pendleton — Senior Product Leader" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <InteractionLayer />
    <Header />
    <main id="main-content"><slot /></main>
    <SoundtrackPlayer />
    <Footer />
  </body>
</html>
