---
import type { CollectionEntry } from 'astro:content';
type Props = { certifications: CollectionEntry<'certifications'>[] };
const { certifications } = Astro.props;
---

<div class="credential-matrix hud-panel">
  <div class="matrix-header"><span>CREDENTIAL VAULT</span><span>{String(certifications.length).padStart(2, '0')} VERIFIED RECORDS</span></div>
  {certifications.map((certification, index) => <article>
    <span class="credential-index">C-{String(index + 1).padStart(2, '0')}</span>
    <div><small>{certification.data.organization}</small><h3>{certification.data.name}</h3></div>
    <span>{certification.data.year ?? 'ACTIVE'}</span>
    {certification.data.credentialUrl ? <a href={certification.data.credentialUrl} target="_blank" rel="noreferrer" aria-label={`View ${certification.data.name} credential`}>↗</a> : <i aria-hidden="true">✓</i>}
  </article>)}
</div>
