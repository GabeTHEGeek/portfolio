---
import launcherPortrait from '../assets/gabriel-pendleton-cyborg-v2.png';
---

<div class="ask-gabriel" data-ask-gabriel>
  <button class="ask-launcher" type="button" aria-expanded="false" aria-controls="ask-gabriel-panel">
    <span class="ask-launcher-signal" aria-hidden="true"></span>
    <span class="ask-launcher-copy"><small>AI INTERFACE</small><strong>ASK GABRIEL</strong><em><i aria-hidden="true"></i> ONLINE</em></span>
    <span class="ask-launcher-action" aria-hidden="true">OPEN <i>↗</i></span>
    <img class="ask-launcher-portrait" src={launcherPortrait.src} alt="" width="40" height="40" aria-hidden="true" />
  </button>

  <section class="ask-panel hud-panel" id="ask-gabriel-panel" role="dialog" aria-modal="false" aria-labelledby="ask-gabriel-title" hidden>
    <header class="ask-panel-header">
      <div>
        <span class="hud-label">KNOWLEDGE INTERFACE // BETA</span>
        <h2 id="ask-gabriel-title">Ask Gabriel</h2>
      </div>
      <button class="ask-close" type="button" aria-label="Close Ask Gabriel">×</button>
    </header>

    <div class="ask-transcript" aria-label="Conversation">
      <div class="ask-intro">
        <span aria-hidden="true">AG // 01</span>
        <p>Hello, I’m Gabriel’s AI assistant. What would you like to know about his projects, experience, or writing?</p>
      </div>
    </div>

    <p class="ask-status" role="status" aria-live="polite"></p>
    <button class="ask-voice-toggle" type="button" data-voice-toggle aria-expanded="false">Talk to Gabriel</button>
    <div class="ask-voice" data-voice hidden><div class="ask-voice-controls"><button type="button" data-voice-start>Start listening</button><button type="button" data-voice-stop hidden>Stop</button><button type="button" data-voice-handsfree>Hands-free: on</button><button type="button" data-voice-mute aria-pressed="false">🔊</button><span data-voice-state>Voice ready</span><span data-voice-timer>00:00</span></div><p data-voice-live aria-live="polite"></p><small data-voice-fallback></small></div>
    <form class="ask-form">
      <label for="ask-gabriel-question">Your question</label>
      <div class="ask-input-row">
        <textarea id="ask-gabriel-question" name="question" rows="2" minlength="3" maxlength="500" placeholder="What is Fleet Command?" required></textarea>
        <input class="ask-trap" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button type="submit"><span>TRANSMIT</span><i aria-hidden="true">↗</i></button>
      </div>
      <small>Enter to send · Shift + Enter for a new line</small>
    </form>
  </section>
</div>

<script>
  import { ServerTTSVoiceProvider, VOICE_DISCLOSURE, VOICE_RETURN_GREETING, formatTimer, getSpeechRecognition } from '../utils/voice';
  type Source = { title?: unknown; url?: unknown };
  type AskResponse = { answer?: unknown; sources?: unknown; error?: unknown };

  const root = document.querySelector<HTMLElement>('[data-ask-gabriel]');
  const launcher = root?.querySelector<HTMLButtonElement>('.ask-launcher');
  const panel = root?.querySelector<HTMLElement>('.ask-panel');
  const close = root?.querySelector<HTMLButtonElement>('.ask-close');
  const form = root?.querySelector<HTMLFormElement>('.ask-form');
  const question = root?.querySelector<HTMLTextAreaElement>('#ask-gabriel-question');
  const transcript = root?.querySelector<HTMLElement>('.ask-transcript');
  const status = root?.querySelector<HTMLElement>('.ask-status');
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  let lastRequestAt = 0;
  let requestInFlight = false;
  let voiceActive = false;
  let voiceRequest = false;
  let voiceHandsFree = true;
  let voiceSpeaking = false;
  let voiceStartedAt = 0;
  let voiceTimer: number | undefined;
  let idleTimer: number | undefined;
  const voicePanel = root?.querySelector<HTMLElement>('[data-voice]');
  const voiceToggle = root?.querySelector<HTMLButtonElement>('[data-voice-toggle]');
  const voiceStart = root?.querySelector<HTMLButtonElement>('[data-voice-start]');
  const voiceStop = root?.querySelector<HTMLButtonElement>('[data-voice-stop]');
  const voiceState = root?.querySelector<HTMLElement>('[data-voice-state]');
  const voiceTimerLabel = root?.querySelector<HTMLElement>('[data-voice-timer]');
  const voiceLive = root?.querySelector<HTMLElement>('[data-voice-live]');
  const voiceFallback = root?.querySelector<HTMLElement>('[data-voice-fallback]');
  const voiceHandsFreeButton = root?.querySelector<HTMLButtonElement>('[data-voice-handsfree]');
  const voiceMuteButton = root?.querySelector<HTMLButtonElement>('[data-voice-mute]');
  const voiceProvider = new ServerTTSVoiceProvider();
  const maxVoiceSeconds = Number(import.meta.env.PUBLIC_ASK_GABRIEL_VOICE_MAX_SESSION_SECONDS || 300);
  const idleVoiceSeconds = Number(import.meta.env.PUBLIC_ASK_GABRIEL_VOICE_IDLE_TIMEOUT_SECONDS || 45);
  const recognition = getSpeechRecognition();

  const formatAnswer = (value: string) => {
    const clean = value
      .replace(/\s*[—–]\s*/g, ', ')
      .replace(/,\s*,/g, ',')
      .replace(/([:.])\s+-\s+(?=\*\*)/g, '$1\n- ')
      .trim();
    if (/^\s*[-*]\s+/m.test(clean)) return clean;
    const sentences = clean.match(/[^.!?]+[.!?]+|[^.!?]+$/g)?.map((sentence) => sentence.trim()).filter(Boolean) ?? [clean];
    const paragraphs: string[] = [];
    let paragraph = '';
    sentences.forEach((sentence) => {
      if (paragraph && `${paragraph} ${sentence}`.length > 150) {
        paragraphs.push(paragraph);
        paragraph = sentence;
      } else paragraph = paragraph ? `${paragraph} ${sentence}` : sentence;
    });
    if (paragraph) paragraphs.push(paragraph);
    return paragraphs.join('\n\n');
  };

  const appendInlineText = (parent: HTMLElement, value: string) => {
    const parts = value.split(/(\*\*[^*]+\*\*)/g).filter(Boolean);
    parts.forEach((part) => {
      if (part.startsWith('**') && part.endsWith('**')) {
        const strong = document.createElement('strong');
        strong.textContent = part.slice(2, -2);
        parent.append(strong);
      } else parent.append(document.createTextNode(part.replace(/\*+/g, '')));
    });
  };

  const renderStructuredAnswer = (item: HTMLElement, value: string) => {
    const body = document.createElement('div');
    body.className = 'ask-answer-body';
    body.setAttribute('aria-hidden', 'true');
    const lines = value.split(/\n/);
    let paragraph: string[] = [];
    let list: HTMLUListElement | null = null;
    const flushParagraph = () => {
      if (!paragraph.length) return;
      const p = document.createElement('p');
      appendInlineText(p, paragraph.join(' '));
      body.append(p);
      paragraph = [];
    };
    lines.forEach((rawLine) => {
      const line = rawLine.trim();
      const bullet = line.match(/^[-*]\s+(.+)$/);
      if (bullet) {
        flushParagraph();
        if (!list) {
          list = document.createElement('ul');
          list.className = 'ask-answer-list';
          body.append(list);
        }
        const li = document.createElement('li');
        appendInlineText(li, bullet[1]);
        list.append(li);
      } else {
        list = null;
        if (!line) flushParagraph();
        else paragraph.push(line.replace(/^#{1,6}\s+/, ''));
      }
    });
    flushParagraph();
    item.querySelector('p')?.remove();
    item.querySelector('.ask-screen-reader-answer')?.before(body);
  };

  const setOpen = (open: boolean) => {
    if (!panel || !launcher) return;
    panel.hidden = !open;
    launcher.setAttribute('aria-expanded', String(open));
    launcher.hidden = open;
    document.body.classList.toggle('ask-gabriel-open', open);
    if (open) question?.focus();
    else launcher.focus();
  };

  const appendSources = (item: HTMLElement, sources: Source[]) => {
    const validSources = sources.filter((source) => typeof source.title === 'string' && typeof source.url === 'string');
    if (!validSources.length) return;
    const list = document.createElement('ul');
    list.setAttribute('aria-label', 'Sources');
    validSources.forEach((source) => {
      try {
        const url = new URL(source.url as string, window.location.origin);
        if (!['http:', 'https:'].includes(url.protocol)) return;
        const li = document.createElement('li');
        const link = document.createElement('a');
        link.href = url.href;
        link.textContent = source.title as string;
        link.target = '_blank';
        link.rel = 'noreferrer';
        li.append(link);
        list.append(li);
      } catch {}
    });
    if (list.children.length) item.append(list);
  };

  const addMessage = (kind: 'question' | 'answer' | 'notice', text: string, sources: Source[] = []) => {
    if (!transcript) return null;
    const item = document.createElement('article');
    item.className = `ask-message ask-message-${kind}`;
    const label = document.createElement('span');
    label.textContent = kind === 'question' ? 'YOU // QUERY' : kind === 'answer' ? 'AG // RESPONSE' : 'SYSTEM // NOTICE';
    const copy = document.createElement('p');
    copy.textContent = text;
    item.append(label, copy);

    appendSources(item, sources);
    transcript.append(item);
    transcript.scrollTop = transcript.scrollHeight;
    return item;
  };

  const addTypedAnswer = async (text: string, sources: Source[]) => {
    if (!transcript) return;
    text = formatAnswer(text);
    const item = addMessage('answer', '', []);
    const visible = item?.querySelector<HTMLParagraphElement>('p');
    if (!item || !visible) return;
    item.classList.add('is-typing');
    const announcement = document.createElement('span');
    announcement.className = 'ask-screen-reader-answer';
    announcement.setAttribute('aria-live', 'polite');
    announcement.textContent = text.replace(/\*\*/g, '').replace(/^\s*[-*]\s+/gm, '• ');
    visible.setAttribute('aria-hidden', 'true');
    item.append(announcement);

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      visible.textContent = text.replace(/\*\*/g, '');
    } else {
      const segments = text.replace(/\*\*/g, '').match(/\S+\s*/g) ?? [text];
      const delay = Math.max(45, Math.min(75, 3800 / Math.max(segments.length, 1)));
      for (const segment of segments) {
        visible.textContent += segment;
        transcript.scrollTop = transcript.scrollHeight;
        await new Promise((resolve) => window.setTimeout(resolve, delay));
      }
    }
    item.classList.remove('is-typing');
    renderStructuredAnswer(item, text);
    appendSources(item, sources);
    transcript.scrollTop = transcript.scrollHeight;
  };

  const addTypingIndicator = () => {
    const item = addMessage('answer', '', []);
    const copy = item?.querySelector<HTMLParagraphElement>('p');
    if (!item || !copy) return null;
    item.classList.add('ask-typing-indicator');
    copy.setAttribute('aria-label', 'Gabriel is typing');
    copy.innerHTML = '<span>Gabriel is typing</span><i></i><i></i><i></i>';
    return item;
  };

  const setVoiceState = (value: string) => { if (voiceState) voiceState.textContent = value; };
  const stopVoice = () => { voiceActive = false; voiceRequest = false; recognition?.stop(); voiceProvider.cancel(); window.clearInterval(voiceTimer); window.clearTimeout(idleTimer); if (voiceStart) voiceStart.hidden = false; if (voiceStop) voiceStop.hidden = true; setVoiceState('Voice ready'); };
  const resetIdle = () => {
    window.clearTimeout(idleTimer);
    if (!voiceActive || voiceRequest || voiceSpeaking) return;
    idleTimer = window.setTimeout(stopVoice, idleVoiceSeconds * 1000);
  };
  const speakAnswer = async (text: string) => {
    voiceSpeaking = true;
    window.clearTimeout(idleTimer);
    recognition?.stop();
    setVoiceState('Speaking');
    try {
      for await (const _ of voiceProvider.synthesize(text)) {}
    } catch {
      if (voiceFallback) voiceFallback.textContent = 'OpenAI voice is temporarily unavailable. The written answer is still available.';
    }
    finally { voiceSpeaking = false; }
    if (voiceActive && voiceHandsFree) setVoiceState('Listening');
  };
  const startVoice = async () => {
    if (!recognition || requestInFlight || voiceActive) return;
    voiceProvider.prepare();
    if (voiceFallback) voiceFallback.textContent = '';
    voiceActive = true; voiceStartedAt = Date.now(); voiceStart!.hidden = true; voiceStop!.hidden = false; resetIdle();
    voiceTimer = window.setInterval(() => { const elapsed = Math.floor((Date.now() - voiceStartedAt) / 1000); if (voiceTimerLabel) voiceTimerLabel.textContent = formatTimer(elapsed); if (elapsed >= maxVoiceSeconds) stopVoice(); }, 1000);
    const isFirstVoiceSession = !sessionStorage.getItem('ask-gabriel-voice-disclosure');
    const opening = isFirstVoiceSession ? VOICE_DISCLOSURE : VOICE_RETURN_GREETING;
    if (isFirstVoiceSession) sessionStorage.setItem('ask-gabriel-voice-disclosure', '1');
    addMessage('answer', opening);
    await speakAnswer(opening);
    if (!voiceActive) return;
    setVoiceState('Listening');
    resetIdle();
    try { recognition.start(); } catch { stopVoice(); }
  };
  voiceHandsFreeButton?.addEventListener('click', () => { voiceHandsFree = !voiceHandsFree; voiceHandsFreeButton.textContent = `Hands-free: ${voiceHandsFree ? 'on' : 'off'}`; if (!voiceActive) startVoice(); });
  voiceMuteButton?.addEventListener('click', () => { const muted = voiceMuteButton.getAttribute('aria-pressed') !== 'true'; voiceMuteButton.setAttribute('aria-pressed', String(muted)); voiceMuteButton.textContent = muted ? '🔇' : '🔊'; voiceProvider.setMuted?.(muted); });
  voiceToggle?.addEventListener('click', async () => {
    const open = Boolean(voicePanel?.hidden);
    if (voicePanel) voicePanel.hidden = !open;
    voiceToggle.setAttribute('aria-expanded', String(open));
    if (!open) {
      stopVoice();
      return;
    }
    voiceHandsFree = true;
    if (voiceHandsFreeButton) voiceHandsFreeButton.textContent = 'Hands-free: on';
    await startVoice();
  });
  voiceStart?.addEventListener('click', startVoice); voiceStop?.addEventListener('click', stopVoice);
  if (!recognition) { voiceToggle?.setAttribute('disabled', 'true'); if (voiceFallback) voiceFallback.textContent = 'Voice input is not supported in this browser. Use the text box instead.'; }
  if (recognition) {
    recognition.continuous = false; recognition.interimResults = true; recognition.lang = 'en-US';
    recognition.onresult = (event: any) => { resetIdle(); let finalText = ''; let interim = ''; for (let i = event.resultIndex; i < event.results.length; i++) (event.results[i].isFinal ? finalText += event.results[i][0].transcript : interim += event.results[i][0].transcript); if (voiceLive) voiceLive.textContent = interim || finalText; if (finalText.trim() && !voiceRequest) { voiceRequest = true; window.clearTimeout(idleTimer); recognition.stop(); setVoiceState('Thinking'); if (question) question.value = finalText.trim(); form?.requestSubmit(); } };
    recognition.onerror = (event: any) => { if (event.error === 'aborted' || event.error === 'no-speech') return; if (voiceFallback) voiceFallback.textContent = event.error === 'not-allowed' ? 'Microphone access was denied. You can still use the text box.' : 'Voice input is unavailable right now. Use the text box instead.'; stopVoice(); };
    recognition.onend = () => { if (voiceActive && !voiceRequest && !voiceSpeaking) { setVoiceState('Listening'); if (voiceHandsFree) window.setTimeout(() => { if (voiceSpeaking) return; try { recognition.start(); } catch {} }, 250); } };
  }

  launcher?.addEventListener('click', () => setOpen(true));
  close?.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && panel && !panel.hidden) setOpen(false);
  });
  question?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' && !event.shiftKey) {
      event.preventDefault();
      form?.requestSubmit();
    }
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!question || !submit || !status || requestInFlight) return;
    const text = question.value.trim();
    if (text.length < 3) {
      status.textContent = 'Enter a question with at least 3 characters.';
      question.focus();
      return;
    }
    const wait = 3000 - (Date.now() - lastRequestAt);
    if (wait > 0) {
      status.textContent = `Please wait ${Math.ceil(wait / 1000)} seconds before asking again.`;
      return;
    }

    addMessage('question', text);
    question.value = '';
    requestInFlight = true;
    lastRequestAt = Date.now();
    submit.disabled = true;
    question.disabled = true;
    root?.classList.add('is-loading');
    status.textContent = 'Searching Gabriel’s portfolio knowledge…';
    const typingIndicator = addTypingIndicator();

    try {
      const payload = { question: text, website: new FormData(form).get('website') };
      const response = await fetch('/.netlify/functions/ask-gabriel', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await response.json() as AskResponse;
      typingIndicator?.remove();
      if (response.status === 404) {
        addMessage('notice', typeof data.answer === 'string' ? data.answer : "I don't have enough information about that yet.");
      } else if (response.status === 429) {
        addMessage('notice', 'The interface has received too many questions. Please wait a moment and try again.');
      } else if (!response.ok || typeof data.answer !== 'string') {
        throw new Error(typeof data.error === 'string' ? data.error : 'Request failed');
      } else {
        const sources = Array.isArray(data.sources) ? data.sources as Source[] : [];
        if (voiceRequest && voiceActive) {
          await Promise.all([addTypedAnswer(data.answer, sources), speakAnswer(data.answer)]);
        } else {
          await addTypedAnswer(data.answer, sources);
        }
      }
      status.textContent = 'Response complete.';
    } catch {
      typingIndicator?.remove();
      addMessage('notice', 'Ask Gabriel is temporarily unavailable. Please try again shortly.');
      status.textContent = 'The request could not be completed.';
    } finally {
      requestInFlight = false;
      submit.disabled = false;
      question.disabled = false;
      root?.classList.remove('is-loading');
      question.focus();
      voiceRequest = false;
      if (voiceActive && voiceHandsFree) { setVoiceState('Listening'); resetIdle(); window.setTimeout(() => { try { recognition?.start(); } catch {} }, 500); }
      else if (voiceActive) stopVoice();
    }
  });
</script>

<style is:global>
  .ask-gabriel{position:fixed;z-index:45;left:18px;bottom:18px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
  .ask-launcher{display:flex;align-items:center;gap:11px;min-width:176px;min-height:62px;padding:9px 12px;border:1px solid var(--cyan);background:color-mix(in srgb,var(--bg) 92%,transparent);color:var(--text);clip-path:polygon(8px 0,100% 0,100% calc(100% - 8px),calc(100% - 8px) 100%,0 100%,0 8px);box-shadow:0 0 24px color-mix(in srgb,var(--cyan) 12%,transparent);backdrop-filter:blur(14px);cursor:pointer;transition:min-width .22s ease,background-color .22s ease,box-shadow .22s ease,transform .22s ease}
  .ask-launcher[hidden]{display:none}
  .ask-launcher:hover,.ask-launcher:focus-visible{min-width:204px;background:color-mix(in srgb,var(--cyan) 11%,var(--panel));box-shadow:0 0 30px color-mix(in srgb,var(--cyan) 24%,transparent);transform:translateY(-2px)}
  .ask-launcher-signal{width:9px;height:9px;border:1px solid var(--cyan);background:var(--cyan);transform:rotate(45deg);box-shadow:0 0 10px var(--cyan)}
  .ask-launcher-copy{flex:1}.ask-launcher small,.ask-launcher strong,.ask-launcher em{display:block;text-align:left}.ask-launcher small{color:var(--cyan);font-size:7px;letter-spacing:.15em}.ask-launcher strong{margin-top:2px;font-size:11px;letter-spacing:.08em}.ask-launcher em{display:flex;align-items:center;gap:5px;margin-top:3px;color:var(--muted);font-size:7px;font-style:normal;letter-spacing:.13em}.ask-launcher em i{width:5px;height:5px;border-radius:50%;background:var(--cyan);box-shadow:0 0 7px var(--cyan)}.ask-launcher-action{display:flex;align-items:center;gap:5px;max-width:0;overflow:hidden;color:var(--cyan);font-size:8px;letter-spacing:.12em;opacity:0;transform:translateX(-5px);transition:max-width .22s ease,opacity .18s ease,transform .22s ease}.ask-launcher-action i{font-style:normal}.ask-launcher:hover .ask-launcher-action,.ask-launcher:focus-visible .ask-launcher-action{max-width:58px;opacity:1;transform:none}
  .ask-panel{display:grid;grid-template-rows:auto minmax(130px,1fr) auto auto;width:min(430px,calc(100vw - 36px));height:min(610px,calc(100vh - 100px));background:color-mix(in srgb,var(--bg) 96%,transparent);backdrop-filter:blur(18px);clip-path:polygon(14px 0,100% 0,100% calc(100% - 14px),calc(100% - 14px) 100%,0 100%,0 14px);box-shadow:0 20px 70px rgba(0,0,0,.45)}
  .ask-panel[hidden]{display:none}.ask-panel-header{display:flex;align-items:start;justify-content:space-between;gap:20px;padding:18px;border-bottom:1px solid var(--line)}.ask-panel-header h2{margin:7px 0 0;font-size:27px;letter-spacing:-.035em;text-transform:uppercase}.ask-close{display:grid;place-items:center;width:36px;height:36px;padding:0;border:1px solid var(--line);background:var(--panel);color:var(--cyan);font:24px/1 ui-monospace,SFMono-Regular,Menlo,monospace;cursor:pointer}.ask-close:hover{border-color:var(--cyan)}
  .ask-transcript{min-height:0;overflow-y:auto;overscroll-behavior:contain;padding:18px;scrollbar-color:var(--cyan) var(--panel)}.ask-intro,.ask-message{padding:13px;border-left:2px solid var(--line);background:color-mix(in srgb,var(--panel) 72%,transparent)}.ask-intro span,.ask-message>span{display:block;margin-bottom:6px;color:var(--cyan);font-size:8px;letter-spacing:.13em}.ask-intro p,.ask-message p{margin:0;color:var(--muted);font:13px/1.6 "Arial Narrow",Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.ask-message{margin-top:12px}.ask-message-question{margin-left:38px;border-left-color:var(--signal)}.ask-message-question>span{color:var(--signal)}.ask-message-answer{border-left-color:var(--cyan)}.ask-message-answer p{color:var(--text)}.ask-message-answer.is-typing p:after{content:"";display:inline-block;width:3px;height:1em;margin-left:5px;background:var(--cyan);vertical-align:-.12em;box-shadow:0 0 7px var(--cyan);animation:ask-caret .7s steps(1,end) infinite}.ask-typing-indicator p{display:flex;align-items:center;gap:5px;color:var(--muted)}.ask-typing-indicator p span{margin-right:3px}.ask-typing-indicator p i{width:5px;height:5px;border-radius:50%;background:var(--cyan);box-shadow:0 0 6px var(--cyan);animation:ask-dot 1s ease-in-out infinite}.ask-typing-indicator p i:nth-of-type(2){animation-delay:.16s}.ask-typing-indicator p i:nth-of-type(3){animation-delay:.32s}.ask-message-notice{border-left-color:var(--orange)}.ask-message-notice>span{color:var(--orange)}.ask-message>ul{display:flex;flex-wrap:wrap;gap:7px;margin:12px 0 0;padding:0;list-style:none}.ask-message a{display:inline-block;padding:6px 8px;border:1px solid var(--line);color:var(--cyan);font-size:9px;letter-spacing:.05em}.ask-message a:hover{text-decoration:underline;text-underline-offset:3px}.ask-answer-body{display:grid;gap:10px}.ask-answer-body p{margin:0}.ask-answer-body strong{color:var(--cyan);font-weight:700}.ask-answer-body .ask-answer-list{display:grid;gap:9px;margin:0;padding:0;list-style:none}.ask-answer-body .ask-answer-list li{position:relative;padding-left:14px;color:var(--text);font:13px/1.55 "Arial Narrow",Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.ask-answer-body .ask-answer-list li:before{content:"";position:absolute;left:1px;top:.62em;width:5px;height:5px;border:1px solid var(--cyan);transform:rotate(45deg)}
