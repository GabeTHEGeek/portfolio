<div class="ask-gabriel" data-ask-gabriel>
  <button class="ask-launcher" type="button" aria-expanded="false" aria-controls="ask-gabriel-panel">
    <span class="ask-launcher-signal" aria-hidden="true"></span>
    <span class="ask-launcher-copy"><small>AI INTERFACE</small><strong>ASK GABRIEL</strong><em><i aria-hidden="true"></i> ONLINE</em></span>
    <span class="ask-launcher-action" aria-hidden="true">OPEN <i>↗</i></span>
  </button>

  <section class="ask-panel hud-panel" id="ask-gabriel-panel" role="dialog" aria-modal="false" aria-labelledby="ask-gabriel-title" hidden>
    <header class="ask-panel-header">
      <div>
        <span class="hud-label">KNOWLEDGE INTERFACE // BETA</span>
        <h2 id="ask-gabriel-title">Ask Gabriel</h2>
      </div>
      <button class="ask-close" type="button" aria-label="Close Ask Gabriel">×</button>
    </header>

    <div class="ask-transcript" aria-label="Conversation">
      <div class="ask-intro">
        <span aria-hidden="true">AG // 01</span>
        <p>Ask about Gabriel’s projects, experience, or writing. Answers use verified portfolio knowledge.</p>
      </div>
    </div>

    <p class="ask-status" role="status" aria-live="polite"></p>
    <form class="ask-form">
      <label for="ask-gabriel-question">Your question</label>
      <div class="ask-input-row">
        <textarea id="ask-gabriel-question" name="question" rows="2" minlength="3" maxlength="500" placeholder="What is Fleet Command?" required></textarea>
        <input class="ask-trap" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button type="submit"><span>TRANSMIT</span><i aria-hidden="true">↗</i></button>
      </div>
      <small>Enter to send · Shift + Enter for a new line</small>
    </form>
  </section>
</div>

<script>
  type Source = { title?: unknown; url?: unknown };
  type AskResponse = { answer?: unknown; sources?: unknown; error?: unknown };

  const root = document.querySelector<HTMLElement>('[data-ask-gabriel]');
  const launcher = root?.querySelector<HTMLButtonElement>('.ask-launcher');
  const panel = root?.querySelector<HTMLElement>('.ask-panel');
  const close = root?.querySelector<HTMLButtonElement>('.ask-close');
  const form = root?.querySelector<HTMLFormElement>('.ask-form');
  const question = root?.querySelector<HTMLTextAreaElement>('#ask-gabriel-question');
  const transcript = root?.querySelector<HTMLElement>('.ask-transcript');
  const status = root?.querySelector<HTMLElement>('.ask-status');
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  let lastRequestAt = 0;
  let requestInFlight = false;

  const setOpen = (open: boolean) => {
    if (!panel || !launcher) return;
    panel.hidden = !open;
    launcher.setAttribute('aria-expanded', String(open));
    launcher.hidden = open;
    document.body.classList.toggle('ask-gabriel-open', open);
    if (open) question?.focus();
    else launcher.focus();
  };

  const appendSources = (item: HTMLElement, sources: Source[]) => {
    const validSources = sources.filter((source) => typeof source.title === 'string' && typeof source.url === 'string');
    if (!validSources.length) return;
    const list = document.createElement('ul');
    list.setAttribute('aria-label', 'Sources');
    validSources.forEach((source) => {
      try {
        const url = new URL(source.url as string, window.location.origin);
        if (!['http:', 'https:'].includes(url.protocol)) return;
        const li = document.createElement('li');
        const link = document.createElement('a');
        link.href = url.href;
        link.textContent = source.title as string;
        link.target = '_blank';
        link.rel = 'noreferrer';
        li.append(link);
        list.append(li);
      } catch {}
    });
    if (list.children.length) item.append(list);
  };

  const addMessage = (kind: 'question' | 'answer' | 'notice', text: string, sources: Source[] = []) => {
    if (!transcript) return null;
    const item = document.createElement('article');
    item.className = `ask-message ask-message-${kind}`;
    const label = document.createElement('span');
    label.textContent = kind === 'question' ? 'YOU // QUERY' : kind === 'answer' ? 'AG // RESPONSE' : 'SYSTEM // NOTICE';
    const copy = document.createElement('p');
    copy.textContent = text;
    item.append(label, copy);

    appendSources(item, sources);
    transcript.append(item);
    transcript.scrollTop = transcript.scrollHeight;
    return item;
  };

  const addTypedAnswer = async (text: string, sources: Source[]) => {
    if (!transcript) return;
    const item = addMessage('answer', '', []);
    const visible = item?.querySelector<HTMLParagraphElement>('p');
    if (!item || !visible) return;
    item.classList.add('is-typing');
    const announcement = document.createElement('span');
    announcement.className = 'ask-screen-reader-answer';
    announcement.setAttribute('aria-live', 'polite');
    announcement.textContent = text;
    visible.setAttribute('aria-hidden', 'true');
    item.append(announcement);

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      visible.textContent = text;
    } else {
      const segments = text.match(/\S+\s*/g) ?? [text];
      const delay = Math.max(45, Math.min(75, 3800 / Math.max(segments.length, 1)));
      for (const segment of segments) {
        visible.textContent += segment;
        transcript.scrollTop = transcript.scrollHeight;
        await new Promise((resolve) => window.setTimeout(resolve, delay));
      }
    }
    item.classList.remove('is-typing');
    appendSources(item, sources);
    transcript.scrollTop = transcript.scrollHeight;
  };

  const addTypingIndicator = () => {
    const item = addMessage('answer', '', []);
    const copy = item?.querySelector<HTMLParagraphElement>('p');
    if (!item || !copy) return null;
    item.classList.add('ask-typing-indicator');
    copy.setAttribute('aria-label', 'Gabriel is typing');
    copy.innerHTML = '<span>Gabriel is typing</span><i></i><i></i><i></i>';
    return item;
  };

  launcher?.addEventListener('click', () => setOpen(true));
  close?.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && panel && !panel.hidden) setOpen(false);
  });
  question?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' && !event.shiftKey) {
      event.preventDefault();
      form?.requestSubmit();
    }
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!question || !submit || !status || requestInFlight) return;
    const text = question.value.trim();
    if (text.length < 3) {
      status.textContent = 'Enter a question with at least 3 characters.';
      question.focus();
      return;
    }
    const wait = 3000 - (Date.now() - lastRequestAt);
    if (wait > 0) {
      status.textContent = `Please wait ${Math.ceil(wait / 1000)} seconds before asking again.`;
      return;
    }

    addMessage('question', text);
    question.value = '';
    requestInFlight = true;
    lastRequestAt = Date.now();
    submit.disabled = true;
    question.disabled = true;
    root?.classList.add('is-loading');
    status.textContent = 'Searching Gabriel’s portfolio knowledge…';
    const typingIndicator = addTypingIndicator();

    try {
      const payload = { question: text, website: new FormData(form).get('website') };
      const response = await fetch('/.netlify/functions/ask-gabriel', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await response.json() as AskResponse;
      typingIndicator?.remove();
      if (response.status === 404) {
        addMessage('notice', typeof data.answer === 'string' ? data.answer : "I don't have enough information about that yet.");
      } else if (response.status === 429) {
        addMessage('notice', 'The interface has received too many questions. Please wait a moment and try again.');
      } else if (!response.ok || typeof data.answer !== 'string') {
        throw new Error(typeof data.error === 'string' ? data.error : 'Request failed');
      } else {
        await addTypedAnswer(data.answer, Array.isArray(data.sources) ? data.sources as Source[] : []);
      }
      status.textContent = 'Response complete.';
    } catch {
      typingIndicator?.remove();
      addMessage('notice', 'Ask Gabriel is temporarily unavailable. Please try again shortly.');
      status.textContent = 'The request could not be completed.';
    } finally {
      requestInFlight = false;
      submit.disabled = false;
      question.disabled = false;
      root?.classList.remove('is-loading');
      question.focus();
    }
  });
</script>

