---
const audioUrl = '/audio/ftl-ben-prunty.mp3';
---

<aside class="soundtrack-player hud-panel" aria-label="Optional site soundtrack">
  <a class="soundtrack-art" href="https://benprunty.bandcamp.com/album/ftl" target="_blank" rel="noreferrer" aria-label="FTL soundtrack by Ben Prunty on Bandcamp"><img src="https://f4.bcbits.com/img/a460013667_1x1_700.avif" alt="FTL Original Soundtrack cover" width="64" height="64" loading="lazy" /></a>
  <div><span>OPTIONAL AUDIO</span><strong>FTL — Ben Prunty</strong><small>Soundtrack credit ↗</small></div>
  <button class="soundtrack-play" type="button" aria-pressed="false" aria-label="Play optional FTL soundtrack"><i aria-hidden="true">▶</i><span>PLAY THIS</span></button>
  <button class="soundtrack-close" type="button" aria-label="Minimize soundtrack player and pause audio">×</button>
  <audio preload="none" loop src={audioUrl}></audio>
</aside>

<script>
  const player = document.querySelector<HTMLElement>('.soundtrack-player');
  const button = player?.querySelector<HTMLButtonElement>('.soundtrack-play');
  const close = player?.querySelector<HTMLButtonElement>('.soundtrack-close');
  const audio = player?.querySelector<HTMLAudioElement>('audio');
  const label = button?.querySelector<HTMLElement>('span');
  const icon = button?.querySelector<HTMLElement>('i');
  if (window.matchMedia('(max-width: 680px)').matches) {
    player?.classList.add('is-minimized');
    button?.setAttribute('aria-label', 'Expand player and play optional FTL soundtrack');
  }
  close?.addEventListener('click', () => {
    audio?.pause();
    player?.classList.remove('is-playing');
    player?.classList.add('is-minimized');
    button?.setAttribute('aria-pressed', 'false');
    button?.setAttribute('aria-label', 'Expand player and play optional FTL soundtrack');
    if (label) label.textContent = 'PLAY THIS';
    if (icon) icon.textContent = '▶';
    button?.focus();
  });
  button?.addEventListener('click', async () => {
    if (!audio) return;
    player?.classList.remove('is-minimized');
    if (audio.paused) {
      try {
        await audio.play();
        button.setAttribute('aria-pressed', 'true');
        button.setAttribute('aria-label', 'Pause optional FTL soundtrack');
        player?.classList.add('is-playing');
        if (label) label.textContent = 'PAUSE';
        if (icon) icon.textContent = 'Ⅱ';
      } catch {
        button.setAttribute('aria-label', 'Optional soundtrack is unavailable');
        if (label) label.textContent = 'AUDIO UNAVAILABLE';
      }
    } else {
      audio.pause();
      button.setAttribute('aria-pressed', 'false');
      button.setAttribute('aria-label', 'Play optional FTL soundtrack');
      player?.classList.remove('is-playing');
      if (label) label.textContent = 'PLAY THIS';
      if (icon) icon.textContent = '▶';
    }
  });
</script>

<style is:global>
  .soundtrack-player.hud-panel { padding-right: 44px; }
  .soundtrack-player .soundtrack-close { position: absolute; right: 5px; top: 50%; transform: translateY(-50%); padding: 0; width: 32px; height: 42px; justify-content: center; font-size: 22px; border-color: var(--line); }
  .soundtrack-player.hud-panel.is-minimized { width: 58px; height: 58px; padding: 3px; display: block; clip-path:polygon(7px 0,100% 0,100% calc(100% - 7px),calc(100% - 7px) 100%,0 100%,0 7px); }
  .soundtrack-player.is-minimized > div,
  .soundtrack-player.is-minimized .soundtrack-close,
  .soundtrack-player.is-minimized .soundtrack-play span { display: none; }
  .soundtrack-player.is-minimized .soundtrack-art { display:block;width:50px;height:50px;pointer-events:none;filter:saturate(.8) brightness(.72); }
  .soundtrack-player.is-minimized .soundtrack-play { position:absolute;inset:3px;width:50px;height:50px;justify-content:center;padding:0;border-color:color-mix(in srgb,var(--cyan) 70%,transparent);background:color-mix(in srgb,var(--bg) 28%,transparent);font-size:17px;box-shadow:inset 0 0 20px rgba(0,0,0,.28); }
  .soundtrack-player.is-minimized .soundtrack-play:hover,.soundtrack-player.is-minimized .soundtrack-play:focus-visible{background:color-mix(in srgb,var(--cyan) 18%,transparent);box-shadow:0 0 18px color-mix(in srgb,var(--cyan) 30%,transparent)}
</style>
